# Server Configuration
PORT=4000
NODE_ENV=development

# MySQL Database Configuration
host=localhost
user=root
password=your_mysql_password
database=airbnb_db

# Session Configuration
secret=your_super_secret_session_key
name=session_cookie

# Multer File Upload Directory
destination=uploads/

# Google Maps API Key (For Geocoding / Location Verification)
KEY=your_google_maps_api_key_here

# Hashids Key (For ID Obfuscation)
hash_key=your_random_hash_key_here
