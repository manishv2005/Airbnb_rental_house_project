<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Host Sign Up – Airbnb</title>
    <link rel="stylesheet" href="/signup.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <%- include('../../partials/host-auth-navbar.ejs', { navbarClass: 'scrolled' }) %>

    <!-- ─── PAGE BODY ──────────────────────────────────────────── -->
    <div class="page-wrap">

        <!-- Left panel -->
        <div class="left-panel">
            <div class="panel-blob b1"></div>
            <div class="panel-blob b2"></div>
            <div class="panel-content">
                <h2 class="panel-title">Become a <span>Host</span></h2>
                <p class="panel-sub">Share your space and start earning. Join thousands of hosts welcoming guests globally.</p>
                <div class="panel-features">
                    <div class="feature">🏡 List your property</div>
                    <div class="feature">💰 Earn on your terms</div>
                    <div class="feature">🛡️ Host liability protection</div>
                </div>
            </div>
        </div>

        <!-- Right panel – form -->
        <main class="form-panel">
            <div class="form-card">
                <div class="form-header">
                    <p class="form-badge">Host Portal</p>
                    <h1 class="form-title">Host account</h1>
                    <p class="form-sub">Already a host? <a href="/auth/Host/login" class="inline-link">Sign in</a></p>
                    <p class="form-sub" style="margin-top: 8px;">Looking to book? <a href="/auth/user/signup" class="inline-link">Sign up as Guest</a></p>
                </div>

                <%- include('../../partials/errors.ejs') %>

                <form class="auth-form" action="/auth/Host/signup" method="POST">


                    <!-- csrf token -->
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    
                    <!-- Tax ID and Phone Number row -->
                    <div class="input-row">
                        <div class="input-group">
                            <label for="taxid">Tax ID</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                                </svg>
                                <input type="text" id="taxid" name="taxid" placeholder="XX-XXXXXXX" value="<%= oldInput ? oldInput.taxid : '' %>" required>
                            </div>
                        </div>
                        <div class="input-group">
                            <label for="phone">Phone number</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                                </svg>
                                <input type="tel" id="phone" name="phonenumber" placeholder="+1 (555) 000-0000" value="<%= oldInput ? oldInput.phonenumber : '' %>" required>
                            </div>
                        </div>
                    </div>

                    <!-- Password row -->
                    <div class="input-row">
                        <div class="input-group">
                            <label for="password">Password</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                                </svg>
                                <input type="password" id="password" name="password" placeholder="Min. 8 characters" required>
                                <button type="button" class="eye-btn" data-target="password" aria-label="Show password">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </button>
                            </div>
                            <!-- Password strength pills -->
                            <div class="strength-pills">
                                <span class="pill" id="req-length">8+ chars</span>
                                <span class="pill" id="req-upper">A-Z</span>
                                <span class="pill" id="req-lower">a-z</span>
                                <span class="pill" id="req-number">0-9</span>
                            </div>
                        </div>
                        <div class="input-group">
                            <label for="confirmPassword">Confirm password</label>
                            <div class="input-wrap">
                                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
                                </svg>
                                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat password" required>
                                <button type="button" class="eye-btn" data-target="confirmPassword" aria-label="Show password">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </button>
                            </div>
                            <span class="match-msg" id="matchMsg"></span>
                        </div>
                    </div>

                    <!-- Terms -->
                    <div class="input-group terms-group">
                        <label class="remember-label">
                            <input type="checkbox" id="terms" name="terms" class="checkbox-native" required>
                            <span class="checkbox-custom"></span>
                            <span>I agree to the <a href="/terms" class="inline-link">Host Terms</a> and <a href="/privacy" class="inline-link">Privacy Policy</a></span>
                        </label>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">
                        <span class="btn-text">Sign up as Host</span>
                        <span class="btn-spinner" style="display:none">
                            <span class="spinner"></span>
                        </span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </button>
                </form>

                <a href="/" class="back-link">← Back to home</a>
            </div>
        </main>
    </div>

    <script>
        // Password toggle
        document.querySelectorAll('.eye-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = document.getElementById(this.dataset.target);
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                this.style.color = isHidden ? 'var(--red)' : '';
                const path = this.querySelector('path');
                if (!isHidden) {
                    path.setAttribute('d', 'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z');
                } else {
                    path.setAttribute('d', 'M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M1 1l22 22');
                }
            });
        });

        // Password strength pills
        const pwdInput = document.getElementById('password');
        const pills = {
            'req-length':  /.{8,}/,
            'req-upper':   /[A-Z]/,
            'req-lower':   /[a-z]/,
            'req-number':  /[0-9]/
        };
        pwdInput.addEventListener('input', () => {
            const v = pwdInput.value;
            Object.entries(pills).forEach(([id, regex]) => {
                document.getElementById(id).classList.toggle('valid', regex.test(v));
            });
        });

        // Password match
        const conf = document.getElementById('confirmPassword');
        const matchMsg = document.getElementById('matchMsg');
        conf.addEventListener('input', () => {
            if (!conf.value) { matchMsg.textContent = ''; return; }
            if (conf.value === pwdInput.value) {
                matchMsg.textContent = '✓ Passwords match';
                matchMsg.className = 'match-msg ok';
            } else {
                matchMsg.textContent = '✗ Passwords do not match';
                matchMsg.className = 'match-msg err';
            }
        });

        // Submit: Simplified password match check
        document.querySelector('.auth-form').addEventListener('submit', function (e) {
            const pwd = document.getElementById('password');
            const cnf = document.getElementById('confirmPassword');
            if (pwd.value !== cnf.value) {
                e.preventDefault();
                matchMsg.textContent = '✗ Passwords do not match';
                matchMsg.className = 'match-msg err';
                return;
            }
        });
    </script>

</body>

</html>
