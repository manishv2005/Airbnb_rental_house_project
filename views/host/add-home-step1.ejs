<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Property - Step 1 | AIrbnb</title>
    <link rel="stylesheet" href="/user-core.css">
    <link rel="stylesheet" href="/add-home-step1.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('../partials/navbar') %>
    
    <%- include('../partials/errors') %>
    
    <div class="step-container">
        <div class="step-card">
            <div class="step-header">
                <h1 class="step-title">Tell us about your place</h1>
                <p class="step-subtitle">Step 1: Property Type and Capacity</p>
            </div>
            
            <form action="<%= locals.editing ? '/host/edit-home-step1' : '/host/add-home-step1' %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="id" value="<%= (locals.oldInput && oldInput.id) ? oldInput.id : '' %>">
                
                <div class="form-group">
                    <label for="property_type_id" class="form-label">What kind of place will you host?</label>
                    <select id="property_type_id" name="property_type_id" class="form-control" required>
                        <option value="" disabled selected>Select Property Type</option>
                        <% if (locals.propertyTypes) { %>
                            <% propertyTypes.forEach(type => { %>
                                <option value="<%= type.type_id %>" <%= (locals.oldInput && oldInput.property_type_id == type.type_id) ? 'selected' : '' %>><%= type.type_name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="listing_type_id" class="form-label">Which of these best describes your place?</label>
                    <select id="listing_type_id" name="listing_type_id" class="form-control" required>
                        <option value="" disabled selected>Select Listing Type</option>
                        <% if (locals.listingTypes) { %>
                            <% listingTypes.forEach(type => { %>
                                <option value="<%= type.ls_type_id %>" <%= (locals.oldInput && oldInput.listing_type_id == type.ls_type_id) ? 'selected' : '' %>><%= type.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="max_guests" class="form-label">Guests</label>
                        <input type="number" id="max_guests" name="max_guests" class="form-control" min="1" placeholder="e.g. 4" value="<%= (locals.oldInput && oldInput.max_guests) ? oldInput.max_guests : '1' %>" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="total_bedrooms" class="form-label">Bedrooms</label>
                        <input type="number" id="total_bedrooms" name="total_bedrooms" class="form-control" min="0" placeholder="e.g. 2" value="<%= (locals.oldInput && oldInput.total_bedrooms) ? oldInput.total_bedrooms : '1' %>" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="total_bathrooms" class="form-label">Bathrooms</label>
                        <input type="number" id="total_bathrooms" name="total_bathrooms" class="form-control" min="0" step="0.5" placeholder="e.g. 1.5" value="<%= (locals.oldInput && oldInput.total_bathrooms) ? oldInput.total_bathrooms : '1' %>" required>
                    </div>
                </div>
                
                <button type="submit" class="btn-submit">Continue to Next Step</button>
            </form>
        </div>
    </div>
</body>
</html>
