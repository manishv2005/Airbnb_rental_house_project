<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Step 3: Location | AIrbnb</title>
    <link rel="stylesheet" href="/user-core.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/add-home-step3.css">
</head>

<body>
    <%- include('../partials/navbar') %>

        <%- include('../partials/errors') %>

            <div class="main-container">
                <h2>Step 3: Where is your place located?</h2>
                <p style="color: #6a6a6a; margin-bottom: 20px;">Guests will only get your exact address once they’ve
                    booked a reservation.</p>

                <div class="map-container">
                    <div class="search-tools">
                        <input id="smart-search-bar" type="text" placeholder="Search your address...">
                        <button type="button" id="locate-me-btn">📍 Use Current Location</button>
                    </div>
                    <div id="map"></div>
                </div>

                <form action="<%= locals.editing ? '/host/edit-home-step3/' + secure_id : '/host/add-home-step3/' + secure_id %>" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <h3 style="margin-bottom: 15px; margin-top: 30px;">Confirm Address Details</h3>

                    <div class="form-group">
                        <label>House / Flat / Apt No. *</label>
                        <input type="text" name="flat_no" placeholder="e.g. Flat 402, Building B" value="<%= locals.oldInput ? oldInput.flat_no : '' %>" required>
                    </div>

                    <div class="form-group">
                        <label>Street Address *</label>
                        <input type="text" name="street_address" id="street_address" value="<%= locals.oldInput ? oldInput.street_address : '' %>" required>
                    </div>

                    <div class="form-group">
                        <label>Nearby Landmark (Optional)</label>
                        <input type="text" name="landmark" placeholder="e.g. Opposite Apollo Pharmacy" value="<%= locals.oldInput ? oldInput.landmark : '' %>">
                    </div>

                    <div class="form-group">
                        <label>City *</label>
                        <input type="text" name="city" id="city" value="<%= locals.oldInput ? oldInput.city : '' %>" readonly required>
                    </div>

                    <div class="form-group">
                        <label>State *</label>
                        <input type="text" name="state" id="state" value="<%= locals.oldInput ? oldInput.state : '' %>" readonly required>
                    </div>

                    <div class="form-group">
                        <label>Pincode *</label>
                        <input type="text" name="pincode" id="pincode" value="<%= locals.oldInput ? oldInput.pincode : '' %>" readonly required>
                    </div>

                    <input type="hidden" name="latitude" id="latitude" value="<%= locals.oldInput ? oldInput.latitude : '' %>" required>
                    <input type="hidden" name="longitude" id="longitude" value="<%= locals.oldInput ? oldInput.longitude : '' %>" required>
                    <input type="hidden" name="country" id="country" value="India">

                    <button type="submit" class="submit-btn">Save & Continue</button>



                </form>
            </div>

          <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    let map, marker;

    // Grab form inputs
    const latInput = document.getElementById('latitude');
    const lngInput = document.getElementById('longitude');
    const cityInput = document.getElementById('city');
    const stateInput = document.getElementById('state');
    const pincodeInput = document.getElementById('pincode');
    const streetInput = document.getElementById('street_address'); // Renamed to match your usage
    const searchInput = document.getElementById("smart-search-bar");
    const locateBtn = document.getElementById('locate-me-btn');

    // Initialize Map
    const defaultLat = parseFloat("<%= locals.oldInput && oldInput.latitude ? oldInput.latitude : 26.9124 %>");
    const defaultLng = parseFloat("<%= locals.oldInput && oldInput.longitude ? oldInput.longitude : 75.7873 %>");
    const defaultLocation = [defaultLat, defaultLng]; 

    // Set up Leaflet map
    map = L.map('map').setView(defaultLocation, 13);

    // Load free OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Create draggable marker
    marker = L.marker(defaultLocation, { draggable: true }).addTo(map);

    // --- EVENT: Smart Search Bar (Autocomplete alternative) ---
    // Note: To keep this 100% free and without extra plugins, we use a standard 'change' event.
    // It searches when the user hits Enter or clicks out of the box.
    searchInput.addEventListener("change", async (e) => {
        const query = e.target.value;
        if (!query) return;

        try {
            // Fetch from Nominatim's forward geocoding API
            const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&addressdetails=1&limit=1`);
            const results = await response.json();

            if (results && results.length > 0) {
                const place = results[0];
                const lat = parseFloat(place.lat);
                const lng = parseFloat(place.lon);

                // Move Map and Marker
                map.setView([lat, lng], 17);
                marker.setLatLng([lat, lng]);

                // Extract and Fill Form Data
                updateHiddenCoordinates(lat, lng);
                parseAndFillAddressComponents(place.address);
                
                // Pre-fill street address estimate
                streetInput.value = place.name || place.display_name.split(',')[0];
            } else {
                alert("No details found for that address. Please try adjusting your search.");
            }
        } catch (error) {
            console.error("Search failed:", error);
            alert("Error connecting to search service.");
        }
    });

    // --- EVENT: Marker Dragged ---
    marker.on("dragend", async () => {
        const position = marker.getLatLng();
        updateHiddenCoordinates(position.lat, position.lng);
        await reverseGeocode(position.lat, position.lng);
    });

    // --- EVENT: Map Clicked ---
    map.on("click", async (e) => {
        const clickedLocation = e.latlng;
        
        marker.setLatLng(clickedLocation);
        updateHiddenCoordinates(clickedLocation.lat, clickedLocation.lng);
        await reverseGeocode(clickedLocation.lat, clickedLocation.lng);
    });

    // --- EVENT: Locate Me Button ---
    locateBtn.addEventListener('click', () => {
        if (navigator.geolocation) {
            const originalText = locateBtn.innerText;
            locateBtn.innerText = "📍 Locating...";

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    // Move Map and Marker
                    map.setView([lat, lng], 17);
                    marker.setLatLng([lat, lng]);

                    // Update Form Data
                    updateHiddenCoordinates(lat, lng);
                    await reverseGeocode(lat, lng);

                    locateBtn.innerText = originalText; 
                },
                (error) => {
                    alert("We couldn't access your location. Please ensure location permissions are granted.");
                    locateBtn.innerText = originalText;
                },
                { enableHighAccuracy: true, timeout: 5000 }
            );
        } else {
            alert("Your browser does not support geolocation.");
        }
    });

    // --- EVENT: Form Submission ---
    document.querySelector('form').addEventListener('submit', (e) => {
        // Since Leaflet markers are always 'on' the map if added, we check if coordinates exist
        if (!latInput.value || !lngInput.value) {
            e.preventDefault();
            alert("Please select your location on the map first!");
            return;
        }

        const confirmed = confirm("Are you sure this is the correct location for your property?");
        if (!confirmed) {
            e.preventDefault(); 
        }
    });


    // --- HELPER FUNCTIONS --- //

    function updateHiddenCoordinates(lat, lng) {
        latInput.value = lat;
        lngInput.value = lng;
    }

    // Connects to free OpenStreetMap API to get address from coordinates
    async function reverseGeocode(lat, lng) {
        try {
            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`);
            const data = await response.json();
            
            if (data && data.address) {
                parseAndFillAddressComponents(data.address);
                streetInput.value = data.display_name.split(',')[0];
            }
        } catch (error) {
            console.error("Reverse geocoding failed:", error);
        }
    }

    function parseAndFillAddressComponents(addressObj) {
        cityInput.value = addressObj.city || addressObj.town || addressObj.village || addressObj.county || addressObj.state_district || addressObj.suburb || "";
        stateInput.value = addressObj.state || "";
        pincodeInput.value = addressObj.postcode || "";
    }
</script>
</body>

</html>





