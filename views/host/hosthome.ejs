<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Managed Homes — Host Dashboard</title>
    <link rel="stylesheet" href="/user-core.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>

    <%- include('../partials/navbar') %>

        <header class="container" style="margin-top: 40px;">
            <h1 class="page-title">My Properties</h1>
            <p class="page-subtitle">Manage and refine your hosted stays</p>
        </header>

        <%- include('../partials/errors', { errors: typeof errors !== 'undefined' ? errors : [] }) %>

        <div class="container">
            <% if (typeof houselist !== 'undefined' && houselist && houselist.length > 0) { %>
                <div class="home-grid">
                    <% houselist.forEach(home=> { %>

                        <div class="home-card">
                            <div class="home-image-wrapper">
                                <img src="<%='/'+ home.image %>" alt="<%= home.name %>" class="home-image">
                            </div>

                            <div class="home-content">
                                <h2 class="home-name">
                                    <%= home.name %>
                                </h2>

                                <div class="home-price-tag">
                                    $<%= home.price %><span class="price-unit"> /night</span>
                                </div>
                                <p class="home-location">Property Number: <%= home.number %></p>

                                <div class="home-actions">
                                    <a href="/host/edit-home/<%= home.id %>?editing=true" class="btn btn-secondary" style="flex:1; text-align: center;">Edit Details</a>
                                    <form action="/host/delete-home/<%= home.id %>" method="POST" style="flex:1;">
                                        <button type="submit" class="btn btn-primary" style="width: 100%; background: linear-gradient(90deg, #E11D48 0%, #BE123C 100%);"
                                            onclick="return confirm('Archive this property?');">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 60px 20px; background: rgba(0,0,0,0.02); border-radius: 12px; margin-bottom: 20px;">
                    <h2 style="color: var(--text-primary); margin-bottom: 12px;">No Properties Yet</h2>
                    <p style="color: var(--text-secondary);">You haven't listed any homes. Click the button below to get started!</p>
                </div>
            <% } %>
        </div>

        <div class="container" style="text-align: center; margin: 40px auto 80px;">
            <a class="btn btn-primary" href="/host/add-home" style="padding: 14px 28px; font-size: 1rem;">Add New Stay</a>
        </div>
</body>

</html>