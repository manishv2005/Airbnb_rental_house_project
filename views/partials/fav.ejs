<form action="/user/add-favourite" method="POST" style="display:inline;">
    <input type="hidden" name="homeId" value="<%= home.id %>">
    <button type="submit" class="btn-fav <%= (fav_home_ids.includes(home.id)) ? 'active' : '' %>" title="<%= (fav_home_ids.includes(home.id)) ? 'Remove from favourite' : 'Add to Favourite' %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="<%= (fav_home_ids.includes(home.id)) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span><%= (fav_home_ids.includes(home.id)) ? (locals.activepage === 'favourite') ? 'Remove from Favourite' : 'Favorited' : 'Add to Favourite' %></span>
    </button>
</form>
