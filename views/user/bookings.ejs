<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Bookings | Airbnb</title>
    <link rel="stylesheet" href="/user-core.css">
</head>

<body>
    <%- include('../partials/user-navbar', {activePage: 'bookings' }) %>

        <main class="container">
            <header>
                <h1 class="page-title">Your Bookings</h1>
                <p class="page-subtitle">Review and manage all the amazing places you've planned to visit.</p>
            </header>

            <% if (houselist && houselist.length> 0) { %>
                <div class="home-grid">
                    <% houselist.forEach(home=> { %>
                        <div class="home-card">
                            <div class="home-image-wrapper">
                                <span
                                    style="position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.7); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; z-index: 10;">Booked</span>
                                <img src="<%='/' + home.image %>" alt="<%= home.name %>" class="home-image">
                            </div>
                            <div class="home-content">
                                <h2 class="home-name">
                                    <%= home.name %>
                                </h2>
                                <p class="home-location">Property ID: <%= home.number %>
                                </p>
                                <div class="home-price-tag">
                                    Total paid: $<%= home.bookingInfo.total_price || home.price %>
                                </div>
                                <p style="font-size: 0.9rem; color: #666; margin-top: 8px; margin-bottom: 16px;">
                                    <%= home.description %>
                                </p>
                                <div class="home-actions">
                                    <a href="/user/booking-details/<%= home.bookingInfo.booking_id %>" class="btn btn-primary" style="width: 100%;">View Booking Details</a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
                <% } else { %>
                    <div
                        style="text-align: center; padding: 80px 20px; background: white; border-radius: 16px; border: 1px dashed #ccc;">
                        <h2 style="color: #666;">No bookings yet.</h2>
                        <p style="margin-top: 10px; color: #999;">Start your adventure today by browsing our homes.</p>
                        <a href="/user/houselist" class="btn btn-primary" style="margin-top: 24px;">Explore Homes</a>
                    </div>
                    <% } %>
        </main>
</body>

</html>