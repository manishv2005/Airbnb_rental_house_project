<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Stays | Houselist</title>
    <link rel="stylesheet" href="/user-core.css">
</head>

<body>
    <%- include('../partials/user-navbar', {activePage: 'houselist' }) %>

        <main class="container">
            <header>
                <h1 class="page-title">Explore All Homes</h1>
                <p class="page-subtitle">Find the perfect place to stay from our diverse selection of homes.</p>
            </header>
            <% if (houselist && houselist.length> 0) { %>
                <div class="home-grid">
                    <% houselist.forEach(home=> { %>
                        <div class="home-card">
                            <div class="home-image-wrapper">
                                <img src="<%= '/' + home.image %>" alt="<%= home.name %>" class="home-image">
                            </div>
                            <div class="home-content">
                                <h2 class="home-name">
                                    <%= home.name %>
                                </h2>
                                <p class="home-location">Property Number: <%= home.number %>
                                </p>
                                <div class="home-price-tag">
                                    $<%= home.price %><span class="price-unit"> /night</span>
                                </div>
                                <p class="line-clamp-2" style="font-size: 0.9rem; color: #666; margin-top: 4px;">
                                    <%= home.description %>
                                </p>

                                <div class="home-actions">
                                    <%- include('../partials/fav', {home: home}) %>
                                        <form action="/user/housedetail/<%= home.id %>" method="GET">
                                            <button type="submit" class="btn btn-primary">Book</button>
                                        </form>
                                        <a href="/user/housedetail/<%= home.id %>" class="btn btn-secondary">Details</a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
                <% } else { %>
                    <div
                        style="text-align: center; padding: 80px 20px; background: white; border-radius: 16px; border: 1px dashed #ccc;">
                        <h2 style="color: #666;">No homes available.</h2>
                        <p style="margin-top: 10px; color: #999;">There are currently no homes listed.</p>
                    </div>
                    <% } %>
        </main>
</body>

</html>